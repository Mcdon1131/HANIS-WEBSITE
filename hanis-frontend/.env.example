# Copy this file to .env and adjust.
# Base URL of your backend. "/api" works in dev thanks to the proxy in vite.config.js.
# In production set the full URL, e.g. https://api.yourdomain.com/api
VITE_API_URL=/api

# Only needed if your product images come back as relative paths (e.g. "uploads/cake.jpg").
# Leave empty if your backend already returns full URLs.
VITE_ASSET_BASE=
